# macOS
.DS_Store

# Node
node_modules/

# Vite build output (keep gitkeep so `go:embed frontend/dist` works on a fresh clone)
frontend/dist/*
!frontend/dist/gitkeep

# Wails build output
build/bin/
frontend/package.json.md5

# Signing material is never committed: the Developer ID private key, its .p12
# export and the App Store Connect API key live in ~/.apple-signing (see the
# "Build & package" section of README.md).
*.p12
*.p8
*.certSigningRequest
